<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Turno #<%= turno.id %> — Controle de Caixa</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f4f6f9; margin: 0; padding: 20px; color: #333; }
        .container { max-width: 900px; margin: auto; background: #fff; padding: 25px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        .top-bar { display: flex; justify-content: space-between; align-items: center; }
        .btn-voltar { text-decoration: none; color: #1e3a8a; font-weight: bold; }
        .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 20px 0; }
        .card { background: #f8fafc; padding: 15px; border-radius: 6px; border-left: 4px solid #1e3a8a; }
        .card span { font-size: 12px; color: #64748b; display: block; }
        .card strong { font-size: 18px; }
        .alert-erro { background: #fee2e2; color: #991b1b; padding: 10px; border-radius: 5px; margin-bottom: 15px; }
        .alert-sucesso { background: #dcfce7; color: #166534; padding: 10px; border-radius: 5px; margin-bottom: 15px; }
        form.mov { display: grid; grid-template-columns: 140px 1fr 140px auto; gap: 10px; margin-bottom: 25px; }
        input, select { padding: 8px; border: 1px solid #ccc; border-radius: 4px; }
        button { background: #1e3a8a; color: #fff; border: none; padding: 9px 16px; border-radius: 4px; cursor: pointer; font-weight: bold; }
        .btn-fechar { background: #b91c1c; }
        .btn-fechar:hover { background: #991b1b; }
        .btn-excluir-mov { background: #dc2626; padding: 5px 10px; font-size: 12px; }
        .btn-excluir-mov:hover { background: #b91c1c; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 25px; }
        th, td { border-bottom: 1px solid #e5e7eb; padding: 10px; text-align: left; }
        .entrada { color: #166534; font-weight: bold; }
        .saida { color: #991b1b; font-weight: bold; }
        .box-fechamento { background: #f1f5f9; padding: 20px; border-radius: 6px; }
        @media (max-width: 700px) { .cards, form.mov { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="container">
        <div class="top-bar">
            <h1>Turno #<%= turno.id %> — <%= turno.operador %></h1>
            <a class="btn-voltar" href="/">← Voltar aos Turnos</a>
        </div>
        <p>Data: <strong><%= turno.data_turno %></strong> | Status: <strong><%= turno.status %></strong></p>

        <% if (erro) { %><div class="alert-erro"><%= erro %></div><% } %>
        <% if (sucesso) { %><div class="alert-sucesso"><%= sucesso %></div><% } %>

        <div class="cards">
            <div class="card"><span>Fundo Inicial</span><strong>R$ <%= turno.valor_inicial.toFixed(2) %></strong></div>
            <div class="card" style="border-color:#16a34a"><span>Total Entradas</span><strong>R$ <%= totalEntradas.toFixed(2) %></strong></div>
            <div class="card" style="border-color:#dc2626"><span>Total Saídas</span><strong>R$ <%= totalSaidas.toFixed(2) %></strong></div>
            <div class="card" style="border-color:#0284c7"><span>Saldo Esperado</span><strong>R$ <%= saldoEsperado.toFixed(2) %></strong></div>
        </div>

        <% if (turno.status === 'ABERTO') { %>
            <h3>Registrar Movimentação</h3>
            <form class="mov" action="/turno/<%= turno.id %>/movimentacao" method="POST">
                <select name="tipo" required>
                    <option value="ENTRADA">ENTRADA (+)</option>
                    <option value="SAIDA">SAÍDA (-)</option>
                </select>
                <input type="text" name="descricao" placeholder="Ex: Venda PIX / Sangria" required>
                <input type="number" step="0.01" min="0.01" name="valor" placeholder="Valor (R$)" required>
                <button type="submit">Lançar</button>
            </form>
        <% } %>

        <h3>Lançamentos do Turno</h3>
        <table>
            <thead>
                <tr>
                    <th>Tipo</th>
                    <th>Descrição</th>
                    <th>Valor</th>
                    <% if (turno.status === 'ABERTO') { %><th>Ação</th><% } %>
                </tr>
            </thead>
            <tbody>
                <% if (movimentacoes.length === 0) { %>
                    <tr><td colspan="<%= turno.status === 'ABERTO' ? 4 : 3 %>">Nenhuma movimentação lançada neste turno.</td></tr>
                <% } %>
                <% movimentacoes.forEach(m => { %>
                    <tr>
                        <td class="<%= m.tipo === 'ENTRADA' ? 'entrada' : 'saida' %>"><%= m.tipo %></td>
                        <td><%= m.descricao %></td>
                        <td>R$ <%= m.valor.toFixed(2) %></td>
                        <% if (turno.status === 'ABERTO') { %>
                            <td>
                                <form action="/turno/<%= turno.id %>/movimentacao/<%= m.id %>/excluir" method="POST" style="margin:0;" onsubmit="return confirm('Excluir este lançamento?');">
                                    <button type="submit" class="btn-excluir-mov">Excluir</button>
                                </form>
                            </td>
                        <% } %>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <div class="box-fechamento">
            <% if (turno.status === 'ABERTO') { %>
                <h3>Encerrar e Conferir Caixa</h3>
                <form action="/turno/<%= turno.id %>/fechar" method="POST" style="display:flex; gap:10px; flex-wrap:wrap;" onsubmit="return confirm('Tem certeza que deseja fechar este turno? Após encerrado, não será mais possível lançar ou excluir movimentações.');">
                    <input type="hidden" name="saldo_esperado" value="<%= saldoEsperado %>">
                    <input type="number" step="0.01" min="0" name="valor_fechamento" placeholder="Valor contado em caixa (R$)" required>
                    <button class="btn-fechar" type="submit">Fechar Turno</button>
                </form>
            <% } else { %>
                <h3>Resultado da Conferência</h3>
                <p>Saldo Esperado: <strong>R$ <%= saldoEsperado.toFixed(2) %></strong></p>
                <p>Valor Contado no Fechamento: <strong>R$ <%= turno.valor_fechamento.toFixed(2) %></strong></p>
                <p>Diferença (Sobra / Quebra): 
                    <strong style="color: <%= turno.diferenca < 0 ? '#dc2626' : '#16a34a' %>">
                        R$ <%= turno.diferenca.toFixed(2) %> 
                        (<%= turno.diferenca === 0 ? 'Caixa Exato' : (turno.diferenca > 0 ? 'Sobra de Caixa' : 'Quebra/Falta de Caixa') %>)
                    </strong>
                </p>
            <% } %>
        </div>
    </div>
</body>
</html>
