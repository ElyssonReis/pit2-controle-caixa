<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Controle de Caixa — PIT II</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f4f6f9; margin: 0; padding: 20px; color: #333; }
        .container { max-width: 960px; margin: auto; background: #fff; padding: 25px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        h1, h2 { color: #1e3a8a; }
        .alert-erro { background: #fee2e2; color: #991b1b; padding: 10px; border-radius: 5px; margin-bottom: 15px; }
        .alert-sucesso { background: #dcfce7; color: #166534; padding: 10px; border-radius: 5px; margin-bottom: 15px; }
        form.novo { display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 10px; margin-bottom: 25px; align-items: end; }
        label { display: block; font-size: 13px; font-weight: bold; margin-bottom: 4px; }
        input { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        button { background: #1e3a8a; color: #fff; border: none; padding: 9px 16px; border-radius: 4px; cursor: pointer; font-weight: bold; }
        button:hover { background: #1d4ed8; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border-bottom: 1px solid #e5e7eb; padding: 12px; text-align: left; }
        th { background: #f8fafc; }
        .badge-aberto { background: #fef08a; color: #854d0e; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; }
        .badge-fechado { background: #e2e8f0; color: #334155; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; }
        .acoes { display: flex; gap: 6px; align-items: center; }
        .btn-ver { text-decoration: none; background: #0f766e; color: white; padding: 6px 12px; border-radius: 4px; font-size: 13px; }
        .btn-del { background: #dc2626; color: white; padding: 6px 10px; font-size: 12px; }
        .btn-del:hover { background: #b91c1c; }
        @media (max-width: 750px) { form.novo { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="container">
        <h1>Controle de Fechamento de Caixa</h1>
        <p>Projeto Integrador Transdisciplinar II — Engenharia de Software (v2.0)</p>

        <% if (erro) { %><div class="alert-erro"><%= erro %></div><% } %>
        <% if (sucesso) { %><div class="alert-sucesso"><%= sucesso %></div><% } %>

        <h2>Abrir Novo Turno</h2>
        <form class="novo" action="/turnos" method="POST">
            <div>
                <label>Nome do Operador</label>
                <input type="text" name="operador" placeholder="Ex: Elysson Reis" required>
            </div>
            <div>
                <label>Data do Turno</label>
                <input type="date" name="data_turno" required>
            </div>
            <div>
                <label>Fundo de Troco (R$)</label>
                <input type="number" step="0.01" min="0" name="valor_inicial" placeholder="100.00" required>
            </div>
            <button type="submit">Iniciar Turno</button>
        </form>

        <h2>Histórico de Turnos</h2>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Operador</th>
                    <th>Data</th>
                    <th>Valor Inicial</th>
                    <th>Resultado</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% if (turnos.length === 0) { %>
                    <tr><td colspan="7">Nenhum turno registrado ainda.</td></tr>
                <% } %>
                <% turnos.forEach(t => { %>
                    <tr>
                        <td>#<%= t.id %></td>
                        <td><%= t.operador %></td>
                        <td><%= t.data_turno %></td>
                        <td>R$ <%= t.valor_inicial.toFixed(2) %></td>
                        <td>
                            <% if (t.status === 'FECHADO' && t.diferenca !== null) { %>
                                <strong style="color: <%= t.diferenca < 0 ? '#dc2626' : '#16a34a' %>">
                                    R$ <%= t.diferenca.toFixed(2) %>
                                </strong>
                            <% } else { %>
                                <span>—</span>
                            <% } %>
                        </td>
                        <td>
                            <span class="<%= t.status === 'ABERTO' ? 'badge-aberto' : 'badge-fechado' %>">
                                <%= t.status %>
                            </span>
                        </td>
                        <td class="acoes">
                            <a class="btn-ver" href="/turno/<%= t.id %>">Acessar</a>
                            <form action="/turno/<%= t.id %>/excluir" method="POST" style="margin:0;" onsubmit="return confirm('Deseja realmente excluir o Turno #<%= t.id %> e todos os seus lançamentos?');">
                                <button type="submit" class="btn-del">Excluir</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</body>
</html>
